# Copia este archivo como .env y ajusta los valores. NUNCA subas el .env al repositorio.

# Puerto del servidor
PORT=4000

# Conexión a PostgreSQL (formato: postgres://usuario:contraseña@host:puerto/base)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniruta
# Base de datos aparte para las pruebas automáticas (se borra y recrea en cada corrida)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniruta_test
# En Render y otros servicios en la nube la conexión requiere SSL
DATABASE_SSL=false

# Clave para firmar las sesiones. Usa una cadena larga y aleatoria en producción.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Dominio de correo permitido para registrarse
ALLOWED_EMAIL_DOMAIN=utb.edu.co

# URL de la aplicación web (para los enlaces de los correos y CORS)
FRONTEND_URL=http://localhost:5173

# ¿Exigir que el usuario confirme su correo antes de iniciar sesión?
REQUIRE_EMAIL_VERIFICATION=true

# Envío de correos: "console" imprime los correos en la terminal (desarrollo);
# "smtp" los envía de verdad con los datos de abajo.
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Uniruta UTB <no-responder@uniruta.app>"
# Enviar también por correo los avisos (solicitudes, respuestas), no solo en la app
EMAIL_AVISOS=false
